{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penname.local/schemas/v3.1/run-record.schema.json",
  "title": "Penname Codex v3.1 Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "pen_name", "role", "provider", "model", "reasoning", "adapter", "status", "started_at", "input_commit", "harness_commit", "packet_sha256", "prompt_sha256"],
  "properties": {
    "schema_version": {"const": "3.1"},
    "run_id": {"type": "string", "minLength": 1},
    "pen_name": {"enum": ["fantasy-author-a", "science-fiction-author-b"]},
    "role": {"enum": ["author", "editor", "verifier"]},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "reasoning": {"type": "string"},
    "adapter": {"type": "string", "minLength": 1},
    "status": {"enum": ["STARTED", "COMPLETED", "FAILED", "BLOCKED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "input_commit": {"type": "string", "minLength": 1},
    "harness_commit": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "output_commit": {"type": ["string", "null"]}
  }
}
