{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penname.local/schemas/v3/scene-packet.schema.json",
  "title": "Penname Codex v3 Scene Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "project",
    "job",
    "revisions",
    "modules",
    "pov",
    "purpose",
    "scene_shape",
    "obligations",
    "invention_budget",
    "context_files",
    "output"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "job": {"enum": ["draft", "structural_repair", "continuity_repair", "voice_revision", "compression", "line_edit"]},
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_commit", "canon", "arc", "state"],
      "properties": {
        "input_commit": {"type": "string", "minLength": 1},
        "canon": {"type": "string", "minLength": 1},
        "arc": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1}
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["combat", "progression", "litrpg"]}
    },
    "pov": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "mode", "knowledge_boundary"],
      "properties": {
        "character": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "knowledge_boundary": {"type": "array", "items": {"type": "string"}}
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "scene_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening_state", "pov_goal", "opposition", "turn", "choice", "outcome", "closing_state"],
      "properties": {
        "opening_state": {"type": "string", "minLength": 1},
        "pov_goal": {"type": "string", "minLength": 1},
        "opposition": {"type": "string", "minLength": 1},
        "turn": {"type": "string", "minLength": 1},
        "choice": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "closing_state": {"type": "string", "minLength": 1}
      }
    },
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_include", "plants", "payoffs", "prohibited_outcomes"],
      "properties": {
        "must_include": {"type": "array", "items": {"type": "string"}},
        "plants": {"type": "array", "items": {"type": "string"}},
        "payoffs": {"type": "array", "items": {"type": "string"}},
        "prohibited_outcomes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "invention_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "approval_required", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string"}},
        "approval_required": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "context_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "path", "required"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "verified_findings": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "exceptions": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_path", "report_path", "target_words", "tolerance_percent"],
      "properties": {
        "draft_path": {"type": "string", "minLength": 1},
        "report_path": {"type": "string", "minLength": 1},
        "target_words": {"type": "integer", "minimum": 1},
        "tolerance_percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    }
  }
}
